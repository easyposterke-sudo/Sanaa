{
  "name": "easyposter-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run lint && npm run test && npm run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run cloudflare:deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "fabric": "^7.2.0",
    "hono": "^4.13.1",
    "html-to-image": "^1.11.13",
    "onnxruntime-web": "^1.27.0",
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zod": "^4.0.17",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.5",
    "wrangler": "^4.122.0"
  }
}
